# Copy this file to .env.local and fill in the values.

# Supabase project URL (Project Settings -> API -> Project URL). Not secret.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service_role key (Project Settings -> API -> API Keys -> service_role,
# marked "secret"). This bypasses Row Level Security — it's a server-only value.
# Never prefix it with NEXT_PUBLIC_, never commit it, never reference it from a
# "use client" file. Only app/api/**/route.js files should ever import it
# (via lib/supabaseAdmin.js).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the phone-agent lead webhook (/api/leads/phone-agent).
# Generate any long random string and put the same value in your voice-AI
# platform's webhook headers as x-api-key. Leave blank to disable the webhook.
PHONE_AGENT_API_KEY=

# Optional: enables the three AI helpers (price lookup, photo scan, route estimate).
# Get one at https://platform.claude.com — the app works fine without it.
ANTHROPIC_API_KEY=

# Optional (local dev only): path to a Chrome/Edge executable for PDF export.
# Auto-detected on Windows if left blank. Not needed on Vercel.
CHROME_PATH=
